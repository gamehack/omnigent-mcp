# Inbound ChatGPT -> MCP authentication (Supabase OAuth 2.1)
MCP_AUTH_MODE=supabase
MCP_HOST=0.0.0.0
MCP_PORT=8787
SUPABASE_PROJECT_URL=https://xnndeqrduxkdlwcdklbc.supabase.co
MCP_RESOURCE_URL=https://omnigent-mcp.qjai.org/mcp
ACCESS_POLICY_FILE=/config/access-policy.json

# Outbound MCP -> Omnigent authentication (user-approved device grant)
OMNIGENT_URL=http://omnigent:8000
OMNIGENT_DEVICE_CLIENT_ID=omnigent-mcp
# Optional shared secret; if set here, set the same value in Omnigent's environment.
OMNIGENT_DEVICE_CLIENT_SECRET=
OMNIGENT_TOKEN_FILE=/data/device-token.json
OMNIGENT_PENDING_FILE=/data/device-pending.json
